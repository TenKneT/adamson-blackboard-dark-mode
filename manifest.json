{
  "manifest_version": 3,
  "name": "Adamson Blackboard Dark Mode",
  "version": "1.1",
  "description": "An OLED black theme for Adamson Blackboard, with muted grades and a saved on/off switch.",
  "permissions": ["storage"],
  "host_permissions": ["https://adamson.blackboard.com/*"],
  "browser_specific_settings": {
    "gecko_android": {
      "strict_min_version": "142.0"
    },
    "gecko": {
      "id": "adamson-blackboard-dark@local.extension",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "action": {
    "default_title": "Adamson Blackboard Dark Mode",
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": ["https://adamson.blackboard.com/*"],
    "css": ["theme.css"],
    "css_origin": "user",
    "js": ["content.js"],
    "run_at": "document_start",
    "all_frames": true,
    "match_about_blank": true
  }]
}
